# ============================================================
# Agent RAG App - 生产环境变量模板 (1Panel / Docker Compose)
# 用法: 复制为 docker-compose.yml 同目录下的 .env, 再执行
#       docker compose up -d --build
# ============================================================

# ---------- 通义千问 DashScope (必填) ----------
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBED_MODEL=text-embedding-v3

# ---------- MinIO (请修改为强密码) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- MySQL (请修改为强密码) ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=agent
MYSQL_PASSWORD=agentpassword
MYSQL_DATABASE=agent_rag

# ---------- 可选: 覆盖端口 / 模型 ----------
# APP_PORT=8000
# DASHSCOPE_CHAT_MODEL=qwen-max
