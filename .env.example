# ==================== 通义千问 DashScope ====================
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBED_MODEL=text-embedding-v3

# ==================== Milvus 向量数据库 ====================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# ==================== MinIO 文件存储 ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# ==================== Redis 会话记忆 ====================
REDIS_URL=redis://redis:6379/0
# memory=内存实现(仅单机开发), redis=Redis存储(生产/分布式, 推荐)
MEMORY_BACKEND=redis

# ==================== MySQL 长期记忆 ====================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=agentpassword
MYSQL_DATABASE=agent_rag

# ==================== 记忆参数 ====================
SHORT_TERM_WINDOW=20
SHORT_TERM_TTL=86400
MEMORY_DEDUP_THRESHOLD=0.85
MEMORY_DECAY_LAMBDA=0.01

# ==================== 应用配置 ====================
UPLOAD_DIR=./data/uploads
DB_PATH=./data/app.db
APP_HOST=0.0.0.0
APP_PORT=8000
